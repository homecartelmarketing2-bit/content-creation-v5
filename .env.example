# ── Kie.ai ──────────────────────────────────────────────────────────
KIE_API_KEY=your_kie_api_key_here

# ── Airtable ────────────────────────────────────────────────────────
AIRTABLE_TOKEN=your_airtable_token_here
AIRTABLE_BASE_ID=appSAnIy8QWSP2aZ9

# ── Zoho WorkDrive ──────────────────────────────────────────────────
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here
# Optional overrides for Phase 12 / Phase 13 Zoho upload destinations.
# Defaults are hardcoded in config/settings.py; only set these if you
# need to point to different folders.
ZOHO_FOLDER_CTA=
ZOHO_FOLDER_POLLS_AND_SLIDER=

# ── Shop Now Overlay (Phase 12) ────────────────────────────────────
# Text drawn at the bottom-center of the Blended Image.
SHOP_NOW_TEXT=SHOP NOW

# ── Brand Watermark (Phase 2: Blended Image) ───────────────────────
# Stamps the HomeCartel logo onto the Blended Image. All downstream
# phases that use the Blended Image as a source will inherit it.
BRAND_WATERMARK_ENABLED=true
# Optional path to a custom watermark PNG (RGBA preferred). When unset,
# the watermark is rendered programmatically using LINE1 / LINE2.
BRAND_WATERMARK_PATH=
BRAND_WATERMARK_LINE1=Home
BRAND_WATERMARK_LINE2=Cartel
# Width as a fraction of the image width (0.10 = 10%).
BRAND_WATERMARK_WIDTH_RATIO=0.10
# Anchor: top-left, top-center, top-right, bottom-left, bottom-center,
# bottom-right, or center.
BRAND_WATERMARK_POSITION=top-center
BRAND_WATERMARK_HORIZONTAL_PADDING_RATIO=0.03
BRAND_WATERMARK_VERTICAL_PADDING_RATIO=0.02
# 0.0 = invisible, 1.0 = fully opaque.
BRAND_WATERMARK_OPACITY=1.0
BRAND_WATERMARK_JPEG_QUALITY=95

# ── Vision LLM (local LM Studio) ───────────────────────────────────
VISION_LLM_MODEL=zai-org/glm-4.6v-flash
VISION_LLM_ENDPOINTS=http://192.168.2.166:1234/v1/chat/completions

# ── Local Photo Directory ───────────────────────────────────────────
LOCAL_PHOTO_DIR=C:\Users\oscar\OneDrive\Desktop\Marketing Photos

# Pinterest scraping
MARKETING_PHOTO_DIR=C:\Users\oscar\OneDrive\Desktop\Marketing Photos
PINTEREST_SEARCH_TERMS=interior design living room lighting,modern home lighting ideas,luxury interior lighting,cozy living room decor
PINTEREST_MIN_PHOTOS=40
PINTEREST_BATCH_SIZE=30
PINTEREST_MAX_SCROLLS=18
PINTEREST_HEADLESS=false
PINTEREST_PROFILE_DIR=data\pinterest_profile
